# Copy to .env for local use (npm run dev). On your host, set these as environment variables.

# Parent PINs (4-8 digits, must be different). Required.
MOM_PIN=
DAD_PIN=
MOM_NAME=Mom
DAD_NAME=Dad

# Daughters. KIDn_YOUNG=true gives the picture-first, big-star view (for the 3-year-old).
KID1_NAME=Big Sister
KID1_EMOJI=🦄
KID1_COLOR=#7c5cff
KID1_YOUNG=false
KID1_PIN=

KID2_NAME=Little Sister
KID2_EMOJI=🐰
KID2_COLOR=#ff6fa8
KID2_YOUNG=true
KID2_PIN=

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite file lives. Point this at a persistent disk on your host.
DB_PATH=./data/home-dojo.sqlite

# Stars needed per progress bar fill while the rewards list is empty.
DEFAULT_GOAL=10

PORT=3000
# Set to true when served over HTTPS (defaults to true when NODE_ENV=production).
SECURE_COOKIES=false
