{
  "manifest_version": 3,
  "name": "Olly Coach Bridge",
  "version": "1.0.0",
  "description": "Tells the Live Sales Coach app on this computer when a HubSpot/Aloware call rings, is answered, and ends. Runs alongside Olly Phone.",
  "host_permissions": [
    "https://app.hubspot.com/*",
    "https://talk.aloware.io/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.hubspot.com/*", "https://talk.aloware.io/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://app.hubspot.com/*", "https://talk.aloware.io/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
